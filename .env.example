NEXTAUTH_URL=https://www.novexa.news
NEXT_PUBLIC_SITE_URL=https://www.novexa.news
NEXTAUTH_SECRET=replace-with-a-long-random-secret
MONGODB_URI=
CRON_SECRET=
CRON_BASE_URL=https://www.novexa.news
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

NEXT_TELEMETRY_DISABLED=1
PORT=3000

API_FOOTBALL_KEY=
API_CRICKET_KEY=
SPORTSCORE_MATCH_LIMIT=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FEED_AI_MAX_OUTPUT_TOKENS=3200
FEED_AI_ENABLED=true
FEED_AI_CATEGORIES=Pakistan,World,Politics,Business,Economy,Technology,Artificial Intelligence,Sports,Health
FEED_IMPORT_LIMIT=5
# Limit indexable automated output. Short or excess feed stories remain drafts for review.
FEED_DAILY_PUBLISH_LIMIT=12
FEED_MIN_PUBLISH_WORDS=600
# Absolute safety floor for public indexing. Content quality is assessed separately;
# a concise, complete report is not rejected only because it is below 500 words.
SEO_ABSOLUTE_MIN_INDEX_WORDS=100
SEO_MIN_LISTING_CHARACTERS=2400
FEED_MIN_SOURCE_CHARS=180
FEED_MIN_QUALITY_SCORE=70
FEED_MIN_ORIGINALITY_SCORE=65
FEED_MIN_FACTUAL_CONFIDENCE=70
FEED_MAX_DUPLICATE_RISK=72
FEED_STORY_WINDOW_DAYS=10
FEED_STORY_SIMILARITY_THRESHOLD=0.72
FEED_AI_DAILY_LIMIT=20
# Shared by the complete feed cron, not repeated for every source.
FEED_AI_PER_CRON_LIMIT=1
# Releases the daily allowance gradually across the UTC day.
FEED_AI_PACE_DAILY_LIMIT=true
# Applies to direct/manual ingestion of an individual source.
FEED_AI_RUN_LIMIT=3
FEED_AI_RETRY_HOURS=24
# Free Google Trends RSS research, cached for 15 minutes. Country codes are evaluated in order.
FEED_TRENDS_ENABLED=true
FEED_TRENDS_GEOS=US,PK,GB,IN
FEED_USE_SOURCE_IMAGES=false
FEED_USE_STOCK_IMAGES=true

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TQYVWTCX0Z
NEXT_IMAGE_UNOPTIMIZED=true
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Free interactive widgets
WIDGET_WEATHER_LOCATION=Karachi
WIDGET_CURRENCY_BASE=USD
WIDGET_CURRENCY_SYMBOLS=PKR,EUR,GBP,AED,SAR,INR
WIDGET_MARKET_SYMBOLS=AAPL,MSFT,GOOGL,BTC-USD,ETH-USD
# WIDGET_MARKET_SYMBOLS controls the stock/crypto symbols shown in Market Watch.
# Examples: AAPL,MSFT,GOOGL,TSLA,BTC-USD,ETH-USD
# Weather uses Open-Meteo and works without an API key. Users can also visit /interactive-widgets?location=London.
# Currency uses Frankfurter and works without an API key.
GOOGLE_ADSENSE_PUBLISHER_ID=pub-5598555907109440
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-5598555907109440

# X automatic publishing (server-only; never use NEXT_PUBLIC_ for secrets)
X_AUTO_PUBLISH=false
# selected = featured/breaking, manual = manually written, all = every published article
X_AUTO_PUBLISH_MODE=selected
# Maximum articles posted by one explicit social retry cron request.
X_AUTO_PUBLISH_BATCH_LIMIT=2
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
